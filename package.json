{
  "name": "at-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:service": "node --watch-path=server --watch-path=src/core server/dev-server.mjs",
    "start": "npm run build && node server/local-server.mjs",
    "build": "node scripts/build-pages.mjs",
    "release": "npm run build && node scripts/publish-singlefile.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "lucide": "1.27.0",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "undici": "^8.9.0"
  }
}
